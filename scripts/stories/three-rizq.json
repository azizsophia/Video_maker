        "style": 0.16,
        "similarity_boost": 0.85,
        "speed": 0.99
      },
      "arabicText": "وَمَن يَتَّقِ ٱللَّهَ يَجْعَل لَّهُۥ مَخْرَجًۭا",
      "foot": "Qur'an 65:2-3 (Surah at-Talaq)"
    },
    {
      "type": "narration",
      "text": "The third is shukr, gratitude. Thank Allah for a little, and He promises to give you more.",
      "video": "main/broll6/three-rizq/4-point-three.mp4",
      "videoDuration": 13,
      "holdSeconds": 0.4,
