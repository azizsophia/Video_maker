        "similarity_boost": 0.85,
        "speed": 0.99
      },
      "arabicText": "لَئِن شَكَرْتُمْ لَأَزِيدَنَّكُمْ",
      "foot": "Qur'an 14:7 (Surah Ibrahim)"
    },
    {
      "type": "narration",
      "text": "The provision may not arrive as money. It can come from where you never expected.",
